# Copy this file to ``.env`` (same directory) and fill in real values.
# ``.env`` is gitignored so secrets never reach the repository.
# docker-compose reads it automatically before starting the container.

# ---- Web authentication ----------------------------------------------------

# Default is "admin" - override if you want a different login name.
WEB_USERNAME=admin

# Strong random value. Generate with:   openssl rand -base64 18
WEB_PASSWORD=replace-me-with-a-strong-password

# Session-signing key. Generate with:   openssl rand -hex 32
# Rotating this logs every existing session out.
WEB_SECRET_KEY=replace-me-with-32-random-hex-bytes

# ---- Runtime overrides (optional) ------------------------------------------

# Set if you want a different host port than 8080.
# WEB_PORT=8080

# Config directory inside the container. Default points at the SSD share.
# VIDEO_PIPELINE_DATA_DIR=/volume1/SDD/video-pipeline-config

# Set to 0 to run the web UI without spawning the folder-watcher threads.
# ENABLE_WATCHER=1
